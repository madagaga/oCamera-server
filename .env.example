# Copy to .env and edit. Never commit .env.

# Public DNS name of the broker (must match the TLS certificate).
MQTT_HOST=mqtt.example.com

# Public DNS name of the TURN / STUN server (may be the same host as the broker).
TURN_HOST=turn.example.com

# Public IP address of this server (coturn `external-ip`).
# Behind a NAT: PUBLIC_IP/PRIVATE_IP.
EXTERNAL_IP=203.0.113.10

# Long random secret shared by coturn and the publisher: `openssl rand -hex 32`
TURN_SECRET=change-me

# Password of the MQTT `admin` account (used by ./scripts/init.sh and by the publisher).
MQTT_ADMIN_PASSWORD=change-me

# Relay UDP port range (open it in the firewall).
TURN_MIN_PORT=49152
TURN_MAX_PORT=49252

# Self-signed broker certificate only: path of the CA inside the publisher
# container, e.g. /certs/ca.crt. Leave empty with a public CA (Let's Encrypt).
MQTT_CAFILE=
